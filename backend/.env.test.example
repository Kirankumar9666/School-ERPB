# Test-only environment template. Copy to .env.test and fill in real values:
#
#   cp backend/.env.test.example backend/.env.test
#
# .env.test is what `npm test` loads, and it is the ONLY thing that decides which
# database the tests run against. NEVER point it at the database the app uses.
#
# The connection strings must name a local, disposable Postgres database created
# for tests — the name must contain the word "test" so the safety guard in
# src/config/test-env.js can tell at a glance that it is safe to wipe. The guard
# refuses to seed anything whose URL does not look like a test database, so even
# a wrong copy of this file fails loudly instead of deleting a school's records.
#
# Do not add real secrets here. The JWT values only need to be stable across the
# suite; they are never used against a real environment.

NODE_ENV=test
PORT=5099

# Local Postgres created for tests (e.g. `schoolerp_test`). The word "test" in
# both the database name and the user name is what the guard looks for.
TEST_DATABASE_URL=postgresql://schoolerp_test:change-me@127.0.0.1:5432/schoolerp_test?schema=public
TEST_DIRECT_URL=postgresql://schoolerp_test:change-me@127.0.0.1:5432/schoolerp_test?schema=public

JWT_SECRET=test-only-secret-not-used-in-production
JWT_REFRESH_SECRET=test-only-refresh-secret-not-used-in-production

ALLOWED_ORIGINS=http://localhost:5173

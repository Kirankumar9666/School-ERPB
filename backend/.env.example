# Backend Environment Variables
# Copy this file to .env and fill in real values. Never commit .env to git.

PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_REFRESH_EXPIRES_IN=7d

# Supabase (connect later)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# PostgreSQL (Prisma). The docker-compose stack provisions a matching db:
#   docker compose up postgres  ->  postgres://schoolerp:<password>@localhost:5432/schoolerp
# (publish 5432 or use `docker compose exec` to reach it)
# Production: point DATABASE_URL at the POOLED connection (Supabase
# transaction pooler, port 6543) with ?pgbouncer=true&connection_limit=10&pool_timeout=20,
# and set DIRECT_URL to the session-pooler/direct URL for `prisma migrate`.
DATABASE_URL=postgresql://schoolerp:schoolerp@localhost:5432/schoolerp
DIRECT_URL=postgresql://schoolerp:schoolerp@localhost:5432/schoolerp

# CORS — comma-separated list of allowed origins
# 5173/5174 = Vite dev (5174 is used when 5173 is already taken), 4173 = vite preview
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4173

# LOG_LEVEL — verbosity gate for logs: debug | info | warn | error.
# Production default is 'warn' (errors + essential warnings only, no request
# logs). 'debug' enables per-request access logs (morgan combined) and error
# stack traces — never leave it on in production.
# LOG_LEVEL=debug

# TRUST_PROXY — how many reverse proxies sit in front of the API.
# 0/unset/false = none (req.ip is the socket address; X-Forwarded-For is
# ignored, so it cannot be spoofed). 1 = one proxy (nginx/traefik/CDN in front).
# 2 = two hops (CDN -> load balancer -> app), and so on. Set this to the REAL
# number of proxies in staging/production, or every user behind the proxy shares
# one IP and the per-IP rate limits treat the whole school as one client. Too
# high lets a client forge X-Forwarded-For and dodge the limits.
# TRUST_PROXY=1

# Rate limiting. Authenticated /api/v1 traffic is keyed per USER (not per IP),
# so a school behind one NAT IP no longer shares one bucket; anonymous requests
# fall back to the per-IP limit. Login is limited per IP AND per account.
# API_RATE_LIMIT_MAX=300             # anonymous requests / 15 min / IP
# API_RATE_LIMIT_USER_MAX=3000       # logged-in requests / 15 min / user
# LOGIN_IP_MAX_ATTEMPTS=50           # failed logins / 15 min / IP
# LOGIN_ACCOUNT_MAX_FAILURES=10      # failed logins / 15 min / username
# CHANGE_PASSWORD_MAX_ATTEMPTS=5     # failed change-password / 15 min / IP

# HTTPS (optional — recommended: terminate TLS at a reverse proxy instead).
# If both are set, the API serves HTTPS directly on PORT.
# TLS_KEY_PATH=path/to/privkey.pem
# TLS_CERT_PATH=path/to/fullchain.pem

# Copy to .env.docker and fill in real values before `docker compose up`.
#   cp .env.docker.example .env.docker
# Variables marked REQUIRED are referenced with ${VAR:?...} in
# docker-compose.yml — the stack refuses to start without them.

# --- Auth (REQUIRED) — production fail-fast: the API won't start without them
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# --- Database (REQUIRED) — the one value that differs per environment
#
# Local / single-host stack (Postgres container from docker-compose.yml; the
# password must match POSTGRES_PASSWORD below):
DATABASE_URL=postgres://schoolerp:change-me@postgres:5432/schoolerp
#
# Staging / production (Supabase transaction pooler — the API talks pgbouncer
# on 6543 through the composed containers):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20
#
# DIRECT_URL is *not* a compose variable: `prisma migrate deploy` reads it on
# the machine/CI job that runs the release step (DEPLOYMENT.md §3.2).
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Postgres container (REQUIRED password) — only used for the local stack
# above; unused when DATABASE_URL points at Supabase.
POSTGRES_USER=schoolerp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=schoolerp

# --- Hosts / ports
FRONTEND_PORT=8080
# Browser origin of the web app (belt-and-braces; nginx makes the API
# same-origin so CORS is normally not exercised). Must be the real public
# origin in staging/production.
ALLOWED_ORIGINS=http://localhost:8080

# --- Logging / rate limiting (optional, defaults shown)
# 'warn' = startup + errors only (no per-request logs). 'debug' is for
# temporary diagnosis, never a permanent production setting.
LOG_LEVEL=warn
# Global /api/v1 requests per client IP per 15 minutes — raise it when a whole
# school shares one NAT IP or before running a load test.
API_RATE_LIMIT_MAX=300
